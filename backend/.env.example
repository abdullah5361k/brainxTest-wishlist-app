PORT=3000
NODE_ENV=development

# Example: brainx-wishlist-demo.myshopify.com
SHOPIFY_SHOP_DOMAIN=your-development-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_api_access_token
SHOPIFY_API_VERSION=2026-04

# Customer metafield used for wishlist storage.
SHOPIFY_METAFIELD_NAMESPACE=custom
SHOPIFY_METAFIELD_KEY=wishlist
MAX_WISHLIST_ITEMS=100

# Comma-separated list of storefront origins allowed to call the API.
# Example: https://your-development-store.myshopify.com,https://your-store.com
CORS_ORIGIN=https://your-development-store.myshopify.com
